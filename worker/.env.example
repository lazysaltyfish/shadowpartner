# Whisper GPU Worker Configuration

# Backend WebSocket URL (ws:// or wss://)
BACKEND_WS_URL=ws://localhost:8000/ws/worker

# Worker authentication token (must match backend WORKER_API_TOKENS)
WORKER_TOKEN=your_secret_token_here

# Worker identifier (must match key in backend WORKER_API_TOKENS)
WORKER_ID=gpu-01

# Whisper model size (tiny, base, small, medium, large)
WHISPER_MODEL_SIZE=base

# Device to run on (cuda, cpu, or None for auto)
WHISPER_DEVICE=cuda

# Use FP16 precision (true/false)
WHISPER_FP16=false

# Audio cache directory
AUDIO_CACHE_DIR=./cache/audio

# Maximum cache size in GB
MAX_CACHE_SIZE_GB=10
