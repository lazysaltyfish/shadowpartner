# ShadowPartner Backend Configuration

# --- Database ---
DATABASE_URL=sqlite:///./data/shadow.db

# --- Storage ---
STORAGE_ROOT_DIR=data/storage

# --- External API Keys ---
# Google Gemini API Key for translation
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model ID
GEMINI_MODEL_ID=gemini-3-flash-preview

# --- Translation ---
# Batch translation chunk size
TRANSLATE_BATCH_CHUNK_SIZE=50

# --- Subtitle Matching ---
# Subtitle similarity warning threshold (0.0 to 1.0)
# Warning will be shown if similarity is below this value
SUBTITLE_SIMILARITY_THRESHOLD=0.1

# --- Network Settings ---
# HTTP Proxy (optional)
# Example: http://127.0.0.1:7890
HTTP_PROXY=
HTTPS_PROXY=

# --- Upload Session Settings ---
# Chunked upload session TTL in seconds
UPLOAD_SESSION_TTL_SECONDS=600

# Sweep interval for expiring uploads (seconds)
UPLOAD_SESSION_SWEEP_SECONDS=60

# --- Rate Limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_HEALTH_CHECK_PER_MINUTE=120
RATE_LIMIT_STATUS_PER_MINUTE=120
RATE_LIMIT_UPLOAD_PER_MINUTE=5
RATE_LIMIT_PROCESS_PER_MINUTE=5

# --- Auth Session Settings ---
# Anonymous session TTL in seconds (default: 1 hour)
AUTH_SESSION_TTL_SECONDS=3600

# Max uploads per session (default: 5)
AUTH_SESSION_MAX_UPLOADS=5

# Max total size per session in bytes (default: 500MB)
AUTH_SESSION_MAX_TOTAL_SIZE=524288000

# --- Admin Panel (Required for admin features) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password_here

# --- CLI Automation (Optional) ---
# Magic token used by automation tools; sent via X-CLI-Token header
# CLI_MAGIC_TOKEN=change-me

# --- GPU Worker Configuration ---
# WebSocket server port for GPU workers (default: 8000, same as API port)
WORKER_WS_PORT=8000

# Worker authentication tokens in JSON format
# Example: {"gpu-worker-1": "secret-token-1", "gpu-worker-2": "secret-token-2"}
WORKER_API_TOKENS={}

# Worker heartbeat check interval in seconds (default: 15)
WORKER_HEARTBEAT_INTERVAL=15

# Worker heartbeat timeout in seconds (default: 30)
WORKER_HEARTBEAT_TIMEOUT=30

# Worker job timeout in seconds (default: 600)
WORKER_JOB_TIMEOUT=600

# Number of retry attempts for worker transcription before failing (default: 2)
WORKER_TRANSCRIBE_RETRY_ATTEMPTS=2

# Backend base URL for internal API calls (default: http://localhost:8000)
BACKEND_BASE_URL=http://localhost:8000

# Temporary file TTL in seconds (default: 3600)
TEMP_FILE_TTL=3600
